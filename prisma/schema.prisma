generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                @id @default(cuid())
  email                  String                @unique
  name                   String?
  /**
   * Public profile URL segment (/u/[profileSlug]); unique when set.
   */
  profileSlug            String?               @unique
  passwordHash           String?
  plan                   String                @default("free") // free | pro (pro displays as Premium)
  /**
   * user | admin
   */
  role                   String                @default("user")
  /**
   * Soft-disable: blocked from sign-in when true
   */
  disabled               Boolean               @default(false)
  /**
   * Dietary identity / prefs (Account). Observant only meaningful when isJewish.
   * Religion (Jewish/Muslim) ≠ food (Kosher/Halal). Kosher food supersedes Halal food.
   */
  isJewish               Boolean               @default(false)
  isObservant            Boolean               @default(false)
  /**
   * Soft prefer kosher + personal kosher chrome (badges/warnings); never a public silo.
   */
  preferKosher           Boolean               @default(false)
  /**
   * Soft prefer Halal + personal chrome; religion flag — not cleared by isJewish alone.
   */
  isMuslim               Boolean               @default(false)
  /**
   * Soft prefer Halal + personal chrome; cleared/disabled when preferKosher or Observant.
   */
  preferHalal            Boolean               @default(false)
  /**
   * Plant prefs: priority vegan > vegetarian > pescatarian (mutually exclusive primary).
   */
  preferVegetarian       Boolean               @default(false)
  preferPescatarian      Boolean               @default(false)
  preferVegan            Boolean               @default(false)
  /**
   * Macro / lifestyle prefs (stack with religion/kosher/halal; carnivore mutually exclusive with plant).
   */
  preferCarnivore        Boolean               @default(false)
  preferAtkins           Boolean               @default(false)
  preferLowCarb          Boolean               @default(false)
  preferLowSugar         Boolean               @default(false)
  /**
   * Prefer low sodium (not “low salt”).
   */
  preferLowSodium        Boolean               @default(false)
  /**
   * JSON string array of allergen ids/labels the user avoids (personal; not a public silo).
   */
  allergenFlags          String                @default("[]")
  /**
   * Activity: bumped from getCurrentUser() at most once per ~5 min (see lib/activity).
   */
  lastActiveAt           DateTime?
  /**
   * Set on successful sign-in (and sign-up, which signs in).
   */
  lastSignInAt           DateTime?
  /**
   * Suspend context; `disabled` stays the actual gate.
   */
  disabledReason         String?
  disabledAt             DateTime?
  /**
   * Admin user id that suspended (no FK so it survives that admin's deletion).
   */
  disabledById           String?
  /**
   * Public profile (Stage 1). `name` is the display name; `profileSlug` is the @handle.
   */
  bio                    String?
  /**
   * Normalized https URLs only (see lib/profile-fields).
   */
  socialX                String?
  socialFacebook         String?
  /**
   * Managed /profile-images/u/... WebP paths.
   */
  avatarUrl              String?
  bannerUrl              String?
  /**
   * false = "This profile is private" to everyone but the owner.
   */
  profilePublic          Boolean               @default(true)
  /**
   * When the user confirmed they meet the minimum age (DOB itself is never stored).
   */
  ageConfirmedAt         DateTime?
  profilePins            ProfilePin[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  sessions               Session[]
  memberships            HouseholdMember[]
  favorites              RecipeFavorite[]
  ownedRecipes           Recipe[]              @relation("RecipeOwner")
  sharesSent             RecipeShare[]         @relation("ShareFrom")
  sharesReceived         RecipeShare[]         @relation("ShareTo")
  recipeRequestsSent     RecipeRequest[]       @relation("RecipeRequestFrom")
  recipeRequestsReceived RecipeRequest[]       @relation("RecipeRequestTo")
  shoppingItems          ShoppingListItem[]
  reviews                RecipeReview[]
  cookSessions           RecipeCookSession[]
  cookStats              RecipeCookStat[]
  howToLessonProgress    HowToLessonProgress[]
  howToBadges            HowToUserBadge[]
  weeklyMenuPlans        WeeklyMenuPlan[]
  activeDays             UserActiveDay[]
  passwordResetTokens    PasswordResetToken[]
  /**
   * Admin-only flag: this account is a chef (manages its own featured profile + Kitchen Table posts).
   */
  isChef                 Boolean               @default(false)
  /**
   * Chef posts publish without review when true; admins can turn it off to require review.
   */
  chefCanPublish         Boolean               @default(true)
  featuredProfile        FeaturedProfile?
  posts                  Post[]                @relation("PostAuthor")
  userDemographics       UserDemographics[]
  recipeViews            RecipeView[]

  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([role])
  @@index([plan])
}

model Session {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  /**
   * Bumped together with User.lastActiveAt (throttled).
   */
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * One row per user per active day (UTC), upserted by activity tracking.
 */
model UserActiveDay {
  userId    String
  day       DateTime @db.Date
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

/**
 * Admin-generated one-time password reset links. Only the sha256 of the token is stored.
 */
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  /**
   * Admin who generated the link.
   */
  createdById String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Append-only log of admin actions. No FKs, so entries survive user deletion.
 */
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String?
  /**
   * e.g. user.role, user.plan, user.suspend, user.unsuspend, user.sessions.revoke, user.reset_link, user.export, user.delete
   */
  action       String
  details      Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Household {
  id               String                     @id @default(cuid())
  name             String
  inviteCode       String                     @unique
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  members          HouseholdMember[]
  pantryItems      PantryItem[]
  recipes          Recipe[]
  coupons          Coupon[]
  customStaples    CustomPantryStaple[]
  shoppingItems    ShoppingListItem[]
  recipeRequests   RecipeRequest[]
  sharesReceived   RecipeShare[]
  cookSessions     RecipeCookSession[]
  cookStats        RecipeCookStat[]
  weeklyMenuPlans  WeeklyMenuPlan[]
  productOverrides HouseholdProductOverride[]
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  userId      String
  role        String    @default("member") // owner | member
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

model PantryItem {
  id             String     @id @default(cuid())
  name           String
  quantity       Float      @default(1)
  unit           String     @default("each")
  category       String?
  tags           String     @default("[]") // JSON array string
  barcode        String?
  expirationDate DateTime?
  /**
   * Optional OFF/macros snapshot JSON: calories/protein/fat/carbs per 100g
   */
  nutritionJson  String?
  /**
   * Product thumb from Open Food Facts (or null → UI category/name icon).
   */
  imageUrl       String?
  householdId    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  household      Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([barcode])
  @@index([householdId])
}

model Recipe {
  id                  String              @id @default(cuid())
  title               String
  description         String?
  steps               String // JSON array of step strings
  costTier            String              @default("cheap") // cheap | moderate
  tags                String              @default("[]") // JSON array
  /**
   * Controlled cuisine label from recipe-taxonomy (e.g. Mexican, Italian).
   */
  cuisine             String?
  /**
   * Controlled course: breakfast | lunch | dinner | main | side | starter | dessert | snack | drink
   */
  course              String?
  /**
   * JSON array of food category labels (dairy, meat, vegetable, …).
   */
  foodCategories      String              @default("[]")
  /**
   * Land-meat subtype when applicable: beef | pork | chicken | other. Null if no meat / unknown. Fish stays seafood.
   */
  meatType            String?
  /**
   * JSON array of ethnicity/national-origin foodways ids (see recipe-taxonomy).
   */
  origins             String              @default("[]")
  /**
   * Short cultural/history blurb shown as “Story behind this food” on detail.
   */
  originStory         String?
  /**
   * JSON array of story media items: {id,kind:"image",url} (managed /recipe-images/user/ path) | {id,kind:"youtube",videoId}.
   */
  originStoryMedia    String              @default("[]")
  /**
   * Normalized dish family slug for variants (e.g. grilled-cheese).
   */
  dishKey             String?
  servings            Int                 @default(2)
  cookTimeMinutes     Int? // null = unknown; excluded when maxMinutes filter is set
  sourceUrl           String?
  imageUrl            String? // remote URL or /recipe-images/... path
  isStruggleMeal      Boolean             @default(false)
  /**
   * Eligible if prepared with certified kosher ingredients (not a certification claim).
   * Independent of Jewish cuisine/origin — a dish can be Jewish and not kosher, or kosher and not Jewish cuisine.
   */
  kosherEligible      Boolean             @default(false)
  /**
   * Eligible if prepared with certified halal ingredients (not a certification claim).
   */
  halalEligible       Boolean             @default(false)
  /**
   * No meat/fish (dairy/eggs OK).
   */
  vegetarianEligible  Boolean             @default(false)
  /**
   * Fish/seafood OK; no land meat.
   */
  pescatarianEligible Boolean             @default(false)
  /**
   * No animal products.
   */
  veganEligible       Boolean             @default(false)
  /**
   * Animal-based (meat/fish/eggs); mutually exclusive with plant prefs for filtering.
   */
  carnivoreEligible   Boolean             @default(false)
  /**
   * Atkins-style low-carb friendly (independent of preferLowCarb).
   */
  atkinsEligible      Boolean             @default(false)
  lowCarbEligible     Boolean             @default(false)
  lowSugarEligible    Boolean             @default(false)
  /**
   * Low sodium (not “low salt”).
   */
  lowSodiumEligible   Boolean             @default(false)
  /**
   * Short note: how to adapt this recipe to kosher when not kosherEligible.
   */
  kosherAdaptNote     String?
  /**
   * Short note: how to adapt this recipe to vegan when not veganEligible.
   */
  veganAdaptNote      String?
  /**
   * Short note: how to adapt this recipe to vegetarian when not vegetarianEligible.
   */
  vegetarianAdaptNote String?
  /**
   * Short note: how to adapt toward Halal when not satisfiesHalal.
   */
  halalAdaptNote      String?
  /**
   * JSON string array of allergen tags (milk, eggs, fish, …) — public recipe info.
   */
  allergenTags        String              @default("[]")
  techniqueTips       String? // JSON array
  flavorBoosters      String? // JSON array
  /**
   * global | household | shared  (legacy aliases: public→global, private→household)
   */
  visibility          String              @default("household")
  ownerUserId         String?
  householdId         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  ingredients         RecipeIngredient[]
  household           Household?          @relation(fields: [householdId], references: [id], onDelete: SetNull)
  owner               User?               @relation("RecipeOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  favorites           RecipeFavorite[]
  profilePins         ProfilePin[]
  shares              RecipeShare[]
  requests            RecipeRequest[]
  reviews             RecipeReview[]
  cookSessions        RecipeCookSession[]
  cookStats           RecipeCookStat[]
  /**
   * Featured profile (chef) this recipe is credited to; shows the Featured Chef badge.
   */
  chefProfileId       String?
  chefProfile         FeaturedProfile?    @relation(fields: [chefProfileId], references: [id], onDelete: SetNull)
  recipeViews         RecipeView[]

  @@index([chefProfileId])
  @@index([householdId])
  @@index([ownerUserId])
  @@index([visibility])
  @@index([cuisine])
  @@index([meatType])
  @@index([course])
  @@index([dishKey])
}

model RecipeIngredient {
  id       String  @id @default(cuid())
  recipeId String
  name     String
  quantity Float   @default(1)
  unit     String  @default("each")
  optional Boolean @default(false)
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model RecipeFavorite {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@index([recipeId])
}

model RecipeShare {
  id            String     @id @default(cuid())
  recipeId      String
  fromUserId    String
  toUserEmail   String?
  toUserId      String?
  /**
   * Optional: share with an entire household (all members can view).
   */
  toHouseholdId String?
  accepted      Boolean    @default(false)
  acceptedAt    DateTime?
  createdAt     DateTime   @default(now())
  recipe        Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  fromUser      User       @relation("ShareFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser        User?      @relation("ShareTo", fields: [toUserId], references: [id], onDelete: SetNull)
  toHousehold   Household? @relation(fields: [toHouseholdId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([toUserEmail])
  @@index([toHouseholdId])
}

model Coupon {
  id           String     @id @default(cuid())
  brand        String
  title        String
  discountText String
  terms        String?
  codeValue    String
  codeType     String     @default("qr") // qr | barcode
  expiresAt    DateTime?
  clipped      Boolean    @default(false)
  used         Boolean    @default(false)
  usedAt       DateTime?
  householdId  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  household    Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([brand])
  @@index([expiresAt])
  @@index([householdId])
}

model CustomPantryStaple {
  id            String     @id @default(cuid())
  name          String
  category      String
  measureKind   String?
  suggestedUnit String?
  hidden        Boolean    @default(false)
  householdId   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  household     Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, name, category])
  @@index([householdId])
  @@index([category])
}

model ShoppingListItem {
  id          String     @id @default(cuid())
  name        String
  quantity    Float?
  unit        String?
  checked     Boolean    @default(false)
  recipeId    String?
  recipeTitle String?
  householdId String?
  userId      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([userId])
  @@index([checked])
}

/**
 * Current week meal plan (breakfast/lunch/dinner × 7) per household or user.
 */
model WeeklyMenuPlan {
  id           String     @id @default(cuid())
  householdId  String?
  userId       String?
  /**
   * JSON WeeklyMenuPlanData
   */
  planJson     String
  struggleMode Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  household    Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([userId])
}

model RecipeRequest {
  id          String     @id @default(cuid())
  recipeId    String
  fromUserId  String
  toUserId    String?
  householdId String?
  status      String     @default("pending") // pending | accepted | declined
  message     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  recipe      Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  fromUser    User       @relation("RecipeRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User?      @relation("RecipeRequestTo", fields: [toUserId], references: [id], onDelete: SetNull)
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([householdId])
  @@index([status])
}

model RecipeReview {
  id        String   @id @default(cuid())
  recipeId  String
  userId    String
  stars     Int
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
  @@index([createdAt])
}

model RecipeCookSession {
  id             String     @id @default(cuid())
  recipeId       String
  userId         String?
  householdId    String?
  /**
   * When true, pantry deductions from this cook are still applied.
   */
  active         Boolean    @default(true)
  /**
   * JSON: [{ pantryItemId, name, unit, deductedQty, quantityBefore, quantityAfter }]
   */
  deductionsJson String     @default("[]")
  /**
   * JSON string array of low-stock nudge messages at cook time
   */
  lowStockJson   String     @default("[]")
  /**
   * Set when pantry restore undoes this cook (cancel or making different).
   */
  undoneAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  recipe         Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  household      Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([userId])
  @@index([householdId])
  @@index([recipeId, householdId, active])
  @@index([recipeId, userId, active])
}

model RecipeCookStat {
  id          String     @id @default(cuid())
  recipeId    String
  /**
   * household:<id> | user:<id> | guest — unique with recipeId
   */
  scopeKey    String
  userId      String?
  householdId String?
  cookCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  recipe      Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@unique([recipeId, scopeKey])
  @@index([recipeId])
  @@index([userId])
  @@index([householdId])
}

model HowToBadge {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String?
  emoji       String           @default("🏅")
  /**
   * Public URL path e.g. /badge-images/xyz.jpg (local public/).
   */
  imageUrl    String?
  /**
   * howto = course award catalog; manual = admin-created award badge.
   */
  kind        String           @default("howto")
  createdAt   DateTime         @default(now())
  courses     HowToCourse[]
  awards      HowToUserBadge[]
}

model HowToCourse {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  sortOrder   Int           @default(0)
  badgeId     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  badge       HowToBadge?   @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  lessons     HowToLesson[]

  @@index([sortOrder])
  @@index([badgeId])
}

model HowToLesson {
  id               String                @id @default(cuid())
  courseId         String
  slug             String
  title            String
  summary          String?
  /**
   * Plain-text lesson body; paragraphs separated by blank lines.
   */
  body             String
  sortOrder        Int                   @default(0)
  estimatedMinutes Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  course           HowToCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress         HowToLessonProgress[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@index([sortOrder])
}

model HowToLessonProgress {
  id          String      @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      HowToLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model HowToUserBadge {
  id        String     @id @default(cuid())
  userId    String
  badgeId   String
  /**
   * Course that triggered the award (optional for future one-off badges).
   */
  courseId  String?
  awardedAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     HowToBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

/**
 * Struggle Mode hub cards (budget tips + kids-eat-free) — admin-editable.
 */
model StruggleResource {
  id        String   @id @default(cuid())
  /**
   * tip | kids_meal
   */
  kind      String
  title     String
  slug      String   @unique
  /**
   * Short blurb on the list card.
   */
  summary   String
  /**
   * Longer detail article (plain text; blank lines = paragraphs; optional markdown links).
   */
  body      String   @default("")
  /**
   * JSON array: [{ "label": string, "url": string }]
   */
  linksJson String   @default("[]")
  /**
   * Kids-meal cadence badge, e.g. "Wed", "Mon", "app Tue".
   */
  whenLabel String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, sortOrder])
  @@index([published])
  @@index([kind, published, sortOrder])
}

/**
 * Pinned recipes on a public profile: kind "own" (my top 3) or "favorite" (from other cooks).
 */
model ProfilePin {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  kind      String
  position  Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, position])
  @@unique([userId, kind, recipeId])
  @@index([recipeId])
}

/**
 * Shared product info keyed by barcode (UPC-A / EAN-13 / EAN-8, normalized).
 * First save wins. Only product info + photo is ever exposed; createdBy* is
 * internal for admin moderation.
 */
model SharedProduct {
  id                   String   @id @default(cuid())
  barcode              String   @unique
  name                 String
  size                 String?
  unit                 String?
  category             String?
  imageUrl             String?
  createdByUserId      String?
  createdByHouseholdId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([createdByUserId, createdAt])
  @@index([name])
}

/**
 * Household-only product info for a barcode; beats SharedProduct for that household.
 */
model HouseholdProductOverride {
  id          String    @id @default(cuid())
  householdId String
  barcode     String
  name        String
  size        String?
  unit        String?
  category    String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, barcode])
  @@index([barcode])
}

/**
 * Admin export / backup jobs. Zips live outside public/ (FF_EXPORT_DIR,
 * default ops/exports), chmod 600, deleted when they expire. Download links are
 * one-time: only the sha256 of the current link token is stored.
 */
model ExportJob {
  id             String    @id @default(cuid())
  /**
   * full | user | content
   */
  kind           String
  targetUserId   String?
  /**
   * queued | running | done | failed | expired
   */
  status         String    @default("queued")
  progress       String?
  encrypted      Boolean   @default(false)
  fileName       String?
  sizeBytes      Int?
  manifestSha256 String?
  error          String?
  linkTokenHash  String?   @unique
  linkExpiresAt  DateTime?
  downloadCount  Int       @default(0)
  expiresAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([createdById, createdAt])
  @@index([status])
}

/**
 * Public featured profile. Today only profileType "chef" (Chef's Corner); the
 * type field leaves room for other profile kinds later without a new table.
 * Linked to a user account (self-managed) or admin-managed with userId null.
 */
model FeaturedProfile {
  id          String        @id @default(cuid())
  profileType String        @default("chef")
  slug        String        @unique
  name        String
  photoUrl    String?
  bio         String?
  /**
   * JSON string array, e.g. ["Le Cordon Bleu", "15 years line cook"].
   */
  credentials String        @default("[]")
  /**
   * JSON array of {label,url} https links.
   */
  links       String        @default("[]")
  youtubeUrl  String?
  userId      String?       @unique
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  /**
   * Set when an admin features/pins the profile; drives "most recently featured".
   */
  featuredAt  DateTime?
  hidden      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  recipes     Recipe[]
  posts       Post[]
  pins        FeaturedPin[]

  @@index([profileType, featuredAt])
}

/**
 * The Kitchen Table: articles, how-tos and announcements.
 */
model Post {
  id               String           @id @default(cuid())
  slug             String           @unique
  /**
   * article | howto | announcement
   */
  kind             String           @default("article")
  title            String
  excerpt          String?
  coverUrl         String?
  /**
   * Sanitized HTML (lib/content/sanitize).
   */
  bodyHtml         String           @default("")
  tags             String           @default("[]")
  relatedRecipeIds String           @default("[]")
  /**
   * draft | review | scheduled | published
   */
  status           String           @default("draft")
  publishAt        DateTime?
  publishedAt      DateTime?
  /**
   * null | "Sponsored" | "Partner"
   */
  sponsorLabel     String?
  reviewNote       String?
  authorUserId     String?
  author           User?            @relation("PostAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  profileId        String?
  profile          FeaturedProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  pins             FeaturedPin[]

  @@index([status, publishAt])
  @@index([authorUserId])
  @@index([profileId])
}

/**
 * Admin-pinned items for the home Featured strip.
 */
model FeaturedPin {
  id          String           @id @default(cuid())
  /**
   * profile | post
   */
  kind        String
  profileId   String?
  profile     FeaturedProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  postId      String?
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  position    Int              @default(0)
  createdById String?
  createdAt   DateTime         @default(now())

  @@index([position])
}

/**
 * Optional, private demographics (account/profile). Never shown publicly.
 * Aggregate research reports only include rows with researchConsent=true AND
 * age16ConfirmedAt set (age checked from a date of birth that is not stored).
 */
model UserDemographics {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * null = prefer not to say | "male" | "female"
   */
  sex              String?
  /**
   * JSON array of heritage ids (lib/demographics/options).
   */
  ethnicities      String    @default("[]")
  /**
   * JSON array of ISO 3166-1 alpha-2 codes.
   */
  originCountries  String    @default("[]")
  researchConsent  Boolean   @default(false)
  consentAt        DateTime?
  /**
   * When the user's age was verified as 16+ for research inclusion (DOB not stored).
   */
  age16ConfirmedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([researchConsent])
}

/**
 * One row per user, recipe and day viewed (dedupes reloads). Cuisine copied at view time.
 */
model RecipeView {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cuisine  String?
  day      DateTime @db.Date
  views    Int      @default(1)
  lastAt   DateTime @default(now())

  @@unique([userId, recipeId, day])
  @@index([cuisine])
  @@index([userId])
}
