generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String?
  passwordHash String?
  plan         String            @default("community") // community | pro
  /** user | admin */
  role         String            @default("user")
  /** Soft-disable: blocked from sign-in when true */
  disabled     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     Session[]
  memberships  HouseholdMember[]
  favorites    RecipeFavorite[]
  ownedRecipes Recipe[]          @relation("RecipeOwner")
  sharesSent   RecipeShare[]     @relation("ShareFrom")
  sharesReceived RecipeShare[]   @relation("ShareTo")
  recipeRequestsSent     RecipeRequest[] @relation("RecipeRequestFrom")
  recipeRequestsReceived RecipeRequest[] @relation("RecipeRequestTo")
  shoppingItems ShoppingListItem[]
  reviews      RecipeReview[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Household {
  id         String            @id @default(cuid())
  name       String
  inviteCode String            @unique
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  members    HouseholdMember[]
  pantryItems PantryItem[]
  recipes    Recipe[]
  coupons    Coupon[]
  customStaples CustomPantryStaple[]
  shoppingItems ShoppingListItem[]
  recipeRequests RecipeRequest[]
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  userId      String
  role        String    @default("member") // owner | member
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

model PantryItem {
  id             String     @id @default(cuid())
  name           String
  quantity       Float      @default(1)
  unit           String     @default("each")
  category       String?
  tags           String     @default("[]") // JSON array string
  barcode        String?
  expirationDate DateTime?
  /** Optional OFF/macros snapshot JSON: calories/protein/fat/carbs per 100g */
  nutritionJson  String?
  /** Product thumb from Open Food Facts (or null → UI category/name icon). */
  imageUrl       String?
  householdId    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  household      Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([barcode])
  @@index([householdId])
}

model Recipe {
  id               String             @id @default(cuid())
  title            String
  description      String?
  steps            String             // JSON array of step strings
  costTier         String             @default("cheap") // cheap | moderate
  tags             String             @default("[]") // JSON array
  /** Controlled cuisine label from recipe-taxonomy (e.g. Mexican, Italian). */
  cuisine          String?
  /** Controlled course: breakfast | lunch | dinner | main | side | starter | dessert | snack | drink */
  course           String?
  /** JSON array of food category labels (dairy, meat, vegetable, …). */
  foodCategories   String             @default("[]")
  /** JSON array of ethnicity/national-origin foodways ids (see recipe-taxonomy). */
  origins          String             @default("[]")
  servings         Int                @default(2)
  cookTimeMinutes  Int?               // null = unknown; excluded when maxMinutes filter is set
  sourceUrl        String?
  imageUrl         String?            // remote URL or /recipe-images/... path
  isStruggleMeal   Boolean            @default(false)
  techniqueTips    String?            // JSON array
  flavorBoosters   String?            // JSON array
  /** private | household | public */
  visibility       String             @default("household")
  ownerUserId      String?
  householdId      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ingredients      RecipeIngredient[]
  household        Household?         @relation(fields: [householdId], references: [id], onDelete: SetNull)
  owner            User?              @relation("RecipeOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  favorites        RecipeFavorite[]
  shares           RecipeShare[]
  requests         RecipeRequest[]
  reviews          RecipeReview[]

  @@index([householdId])
  @@index([ownerUserId])
  @@index([visibility])
  @@index([cuisine])
  @@index([course])
}

model RecipeIngredient {
  id       String @id @default(cuid())
  recipeId String
  name     String
  quantity Float  @default(1)
  unit     String @default("each")
  optional Boolean @default(false)
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model RecipeFavorite {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@index([recipeId])
}

model RecipeShare {
  id          String    @id @default(cuid())
  recipeId    String
  fromUserId  String
  toUserEmail String?
  toUserId    String?
  accepted    Boolean   @default(false)
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  fromUser    User      @relation("ShareFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User?     @relation("ShareTo", fields: [toUserId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([toUserEmail])
}

model Coupon {
  id           String     @id @default(cuid())
  brand        String
  title        String
  discountText String
  terms        String?
  codeValue    String
  codeType     String     @default("qr") // qr | barcode
  expiresAt    DateTime?
  clipped      Boolean    @default(false)
  used         Boolean    @default(false)
  usedAt       DateTime?
  householdId  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  household    Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([brand])
  @@index([expiresAt])
  @@index([householdId])
}


model CustomPantryStaple {
  id          String     @id @default(cuid())
  name        String
  category    String
  measureKind String?
  suggestedUnit String?
  hidden      Boolean    @default(false)
  householdId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@unique([householdId, name, category])
  @@index([householdId])
  @@index([category])
}


model ShoppingListItem {
  id          String     @id @default(cuid())
  name        String
  quantity    Float?
  unit        String?
  checked     Boolean    @default(false)
  recipeId    String?
  recipeTitle String?
  householdId String?
  userId      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([userId])
  @@index([checked])
}

model RecipeRequest {
  id          String    @id @default(cuid())
  recipeId    String
  fromUserId  String
  toUserId    String?
  householdId String?
  status      String    @default("pending") // pending | accepted | declined
  message     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  fromUser    User      @relation("RecipeRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User?     @relation("RecipeRequestTo", fields: [toUserId], references: [id], onDelete: SetNull)
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([householdId])
  @@index([status])
}

model RecipeReview {
  id        String   @id @default(cuid())
  recipeId  String
  userId    String
  stars     Int
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
  @@index([createdAt])
}

