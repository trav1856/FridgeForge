generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PantryItem {
  id             String    @id @default(cuid())
  name           String
  quantity       Float     @default(1)
  unit           String    @default("each")
  category       String?
  tags           String    @default("[]") // JSON array string
  barcode        String?
  expirationDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([barcode])
}

model Recipe {
  id               String             @id @default(cuid())
  title            String
  description      String?
  steps            String             // JSON array of step strings
  costTier         String             @default("cheap") // cheap | moderate
  tags             String             @default("[]") // JSON array
  servings         Int                @default(2)
  sourceUrl        String?
  imageUrl         String?            // remote URL or /recipe-images/... path
  isStruggleMeal   Boolean            @default(false)
  techniqueTips    String?            // JSON array
  flavorBoosters   String?            // JSON array
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ingredients      RecipeIngredient[]
}

model RecipeIngredient {
  id       String @id @default(cuid())
  recipeId String
  name     String
  quantity Float  @default(1)
  unit     String @default("each")
  optional Boolean @default(false)
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Coupon {
  id           String    @id @default(cuid())
  brand        String
  title        String
  discountText String
  terms        String?
  codeValue    String
  codeType     String    @default("qr") // qr | barcode
  expiresAt    DateTime?
  clipped      Boolean   @default(false)
  used         Boolean   @default(false)
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([brand])
  @@index([expiresAt])
}
