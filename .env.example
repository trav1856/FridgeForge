# SQLite database (relative to prisma/ or absolute path)
DATABASE_URL="file:./dev.db"

# Optional: override scrape user-agent
# SCRAPE_USER_AGENT="FridgeForge/0.1 (+local-dev)"

# Optional: local Ollama for low-confidence receipt lines (fail-open if down)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:1b
