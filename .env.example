# Postgres (production / Corelia → Endor)
# Copy to .env and set a real URL. Local secrets live in ops/.env.postgres.local (gitignored).
DATABASE_URL="postgresql://fridgeforge_app:CHANGE_ME@192.168.1.87:2665/fridgeforge?schema=public"

# Legacy SQLite (dev-only; not used after Postgres cutover):
# DATABASE_URL="file:./dev.db"

# Optional: override scrape user-agent (default is a Chrome desktop UA).
# Many recipe CDNs 403 bot-like agents on the first request.
# SCRAPE_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"

# Optional: local Ollama for low-confidence receipt lines (fail-open if down)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:1b
